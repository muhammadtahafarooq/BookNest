# Database (PostgreSQL)
# Transaction-mode database URL used by the running app
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Session-mode URL used only for `prisma migrate`
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth - generate with: openssl rand -base64 48  (min 32 chars, never commit)
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# CORS - the exact frontend origin(s). Restrict to your real domain in production.
FRONTEND_URL="http://localhost:5173"
# Comma-separated list allowed if multiple origins:
# FRONTEND_URL="http://localhost:5173,https://books.yourdomain.com"

# Server
PORT=3000
NODE_ENV="development"

# Optional: expose Swagger docs in production (off by default)
# SWAGGER_ENABLED="true"

# Connection pool (defaults are fine for small-to-medium apps)
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_CONNECTION_TIMEOUT=5000